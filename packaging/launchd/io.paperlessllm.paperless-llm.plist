<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.paperlessllm.paperless-llm</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PAPERLESS_LLM_BINARY__</string>
    <string>serve</string>
    <string>--data-dir</string>
    <string>__PAPERLESS_LLM_DATA_DIR__</string>
    <string>--bind</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8765</string>
    <string>--no-open</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PAPERLESS_LLM_DATA_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>paperless_llm=info</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__PAPERLESS_LLM_LOG_DIR__/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PAPERLESS_LLM_LOG_DIR__/stderr.log</string>

  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
